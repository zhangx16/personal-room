# 浏览器访问地址，生产使用自己的 HTTPS 域名；本机体验可用 http://localhost:22836。
PORTAL_ORIGIN=https://room.example.com
PORTAL_SITE_NAME=Dev Room
# 仅在首次初始化时生效，不会重置已有管理员。
PORTAL_ADMIN_USERNAME=admin
# Docker 的宿主机端口；Node 原生运行也使用此端口。
PORT=22836
HOST=127.0.0.1
# 原生 Node 数据路径；Docker 内固定使用 /app/data 命名卷。
PORTAL_DATA_DIR=./data
# 仅自动 HTTPS 方案使用，只填域名。
PORTAL_DOMAIN=room.example.com
